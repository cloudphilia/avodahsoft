{
  "name": "avodah-site",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "avodahsoft.com", "custom_domain": true }
  ],
  "vars": { "CONTACT_TO": "hello@avodahsoft.com" },
  "observability": { "enabled": true }
}
